      "name": "data_sync_checkup",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const jsrsasign = pm.require('npm:jsrsasign@11.1.3');\r",
              "const CryptoJS = pm.require('npm:crypto-js@4.2.0');\r",
              "\r",
              "function signRSA(payload, privateKey) {\r",
              "    const keyObj = jsrsasign.KEYUTIL.getKey(privateKey);\r",
              "    const sig = new jsrsasign.KJUR.crypto.Signature({\r",
              "        alg: \"SHA256withRSA\"\r",
              "    });\r",
              "    sig.init(keyObj);\r",
              "    sig.updateString(payload);\r",
              "    const hexSig = sig.sign();\r",
              "    return jsrsasign.hex2b64(hexSig);\r",
              "}\r",
              "\r",
              "function sha256Uppercase(str) {\r",
              "    return CryptoJS.SHA256(str)\r",
              "        .toString(CryptoJS.enc.Hex)\r",
              "        .toUpperCase();\r",
              "}\r",
              "\r",
              "// Get private Key\r",
              "const privateKey = pm.collectionVariables.get(\"private-key\");\r",
              "\r",
              "// Request Body\r",
              "const rawBody = pm.request.body.raw;\r",
              "const resolvedBody = JSON.parse(pm.variables.replaceIn(rawBody));\r",
              "\r",
              "// Build Compare Data\r",
              "const headerStr = JSON.stringify(resolvedBody.header);\r",
              "const headerSha = sha256Uppercase(headerStr);\r",
              "const dataSha = sha256Uppercase((resolvedBody.data || \"\").trim());\r",
              "const compareData = `${headerSha}.${dataSha}`;\r",
              "\r",
              "// Generate signature\r",
              "const signature = signRSA(compareData, privateKey);\r",
              "\r",
              "// Update request & variables\r",
              "pm.environment.set(\"signature\", signature);\r",
              "resolvedBody.signature = signature;\r",
              "pm.request.body.raw = JSON.stringify(resolvedBody);\r",
              "pm.collectionVariables.set(\"signature\",signature);\r",
              "\r",
              "// Log Debug\r",
              "// console.log(\"headerStr:\", headerStr);\r",
              "// console.log(\"headerSha:\", headerSha);\r",
              "// console.log(\"dataSha:\", dataSha);\r",
              "// console.log(\"compareData:\", compareData);\r",
              "console.log(\"signature:\", signature);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {
              "npm:jsrsasign@11.1.3": {
                "id": "npm:jsrsasign@11.1.3"
              },
              "npm:crypto-js@4.2.0": {
                "id": "npm:crypto-js@4.2.0"
              }
            },
            "requests": {}
          }
        }
      ],
      "request": {
