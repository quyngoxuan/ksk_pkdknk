# Copy this file to .env and set the real password locally. Do not commit .env.
APP_NAME=KSK API
APP_ENV=development
SQL_SERVER=172.29.71.63\PKNK
SQL_DATABASE=PKNK_KSK
SQL_USERNAME=sa
SQL_PASSWORD=change-me
# Set this to a driver installed on the API host.
SQL_DRIVER=SQL Server Native Client 11.0
SQL_TRUST_SERVER_CERTIFICATE=yes
# Comma-separated origins. Use the address of the web form in production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Lien thong Ho so suc khoe dien tu Thanh pho Ha Noi (Phu luc II, PDF 20/07/2026).
LIEN_THONG_BASE_URL=https://api-hssk.hanoi.gov.vn
LIEN_THONG_USERNAME=
LIEN_THONG_PASSWORD=
LIEN_THONG_SENDER_ID=
LIEN_THONG_RECEIVER_ID=VTS
LIEN_THONG_VERSION=1.0
# Chu ky so Base64 phai tuan theo huong dan ky so do don vi cap tai khoan cung cap.
LIEN_THONG_TIMEOUT_SECONDS=30
# Protect batch audit endpoints. Generate a long random value and enter the same value
# in TOOL_LIENTHONG settings; the desktop stores it with Windows DPAPI.
KSK_BATCH_API_KEY=
# Batch audit rows (including portal response text) are purged after this many days.
LIEN_THONG_BATCH_RETENTION_DAYS=90
